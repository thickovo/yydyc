page {
  background: #FFF7F9;
  overflow-x: hidden;
}

.page {
  position: relative;
  z-index: 2;
  padding: 24rpx 28rpx 160rpx;
}

/* ===== 页头 ===== */
.page-head {
  text-align: center;
  margin-bottom: 24rpx;
  padding: 8rpx 4rpx;
}

.page-title-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #5B3A48;
  letter-spacing: 4rpx;
}

.title-deco {
  width: 40rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: linear-gradient(90deg, rgba(255, 194, 214, 0), #FFB6C1);
}

.title-deco:last-child {
  background: linear-gradient(90deg, #FFB6C1, rgba(255, 194, 214, 0));
}

.page-sub {
  font-size: 24rpx;
  color: #B39AA7;
  letter-spacing: 2rpx;
}

/* ===== 搜索栏 ===== */
.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.88);
  border: 2rpx solid rgba(255, 255, 255, 0.95);
  border-radius: 44rpx;
  padding: 18rpx 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(255, 155, 181, 0.12);
  backdrop-filter: blur(16rpx);
}

.search-icon {
  width: 22rpx;
  height: 22rpx;
  border: 3rpx solid #D8A9BC;
  border-radius: 50%;
  margin-right: 16rpx;
  position: relative;
  flex-shrink: 0;
}

.search-icon::after {
  content: '';
  position: absolute;
  bottom: -7rpx;
  right: -5rpx;
  width: 8rpx;
  height: 3rpx;
  background: #D8A9BC;
  border-radius: 2rpx;
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #5B3A48;
}

.filter-toggle {
  height: 80rpx;
  padding: 0 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: var(--grad-rose);
  border-radius: 40rpx;
  box-shadow: var(--shadow-btn);
  flex-shrink: 0;
}

.filter-toggle-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

.filter-toggle-icon {
  width: 24rpx;
  height: 18rpx;
  position: relative;
}

.filter-toggle-icon::before,
.filter-toggle-icon::after {
  content: '';
  position: absolute;
  left: 0;
  width: 24rpx;
  height: 3rpx;
  background: #FFFFFF;
  border-radius: 2rpx;
}

.filter-toggle-icon::before { top: 0; }
.filter-toggle-icon::after { bottom: 0; width: 16rpx; }

/* ===== 添加按钮 ===== */
.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: var(--grad-rose);
  border-radius: 48rpx;
  padding: 22rpx 0;
  text-align: center;
  margin-bottom: 26rpx;
  box-shadow: var(--shadow-btn);
  transition: transform 0.15s ease;
}

.add-btn:active {
  transform: scale(0.97);
}

.add-btn-plus {
  width: 24rpx;
  height: 24rpx;
  position: relative;
}

.add-btn-plus::before,
.add-btn-plus::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: #FFFFFF;
  border-radius: 2rpx;
}

.add-btn-plus::before { width: 20rpx; height: 4rpx; }
.add-btn-plus::after { width: 4rpx; height: 20rpx; }

.add-btn-text {
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: 700;
  letter-spacing: 2rpx;
}

/* ===== 柜子筛选栏 ===== */
.cabinet-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 26rpx;
}

.cabinet-picker {
  flex: 1;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.88);
  border: 2rpx solid rgba(255, 255, 255, 0.95);
  border-radius: 40rpx;
  padding: 16rpx 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(255, 155, 181, 0.12);
}

.cabinet-picker-label {
  font-size: 24rpx;
  color: #B39AA7;
  margin-right: 16rpx;
}

.cabinet-picker-value {
  flex: 1;
  font-size: 26rpx;
  font-weight: 600;
  color: #5B3A48;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cabinet-picker-arrow {
  font-size: 22rpx;
  color: #D8A9BC;
  margin-left: 12rpx;
}

.cabinet-manage {
  flex-shrink: 0;
  height: 76rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--sakura-200);
  border: 2rpx solid var(--sakura-300);
  border-radius: 38rpx;
}

.cabinet-manage-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #E05A86;
}

/* ===== 柜子管理抽屉内容 ===== */
.cabinet-add-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  align-items: center;
}

.cabinet-add-input {
  flex: 1;
  min-width: 0;
  /* 给一个最小高度，避免被旁边的按钮压扁导致文字被裁掉一半 */
  height: 80rpx;
  line-height: 80rpx;
  font-size: 26rpx;
  color: #5B3A48;
  background: #FFEDF2;
  border: 2rpx solid #FFDCE7;
  border-radius: 24rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.cabinet-add-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 按钮显式给高，与输入框对齐，避免输入框被压矮文字被截断 */
  height: 80rpx;
  padding: 0 36rpx;
  background: var(--grad-rose);
  border-radius: 24rpx;
  box-shadow: var(--shadow-btn);
}

.cabinet-add-btn-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.cabinet-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.cabinet-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  background: #FFFFFF;
  border: 2rpx solid #FFE0EA;
  border-radius: 24rpx;
  padding: 18rpx 22rpx;
}

.cabinet-row-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #5B3A48;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cabinet-row-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}

.cabinet-row-btn {
  font-size: 23rpx;
  padding: 8rpx 22rpx;
  border-radius: 22rpx;
  font-weight: 500;
}

.cabinet-row-btn.rename {
  color: #E05A86;
  background: #FFF0F3;
  border: 2rpx solid #FFD0DC;
}

.cabinet-row-btn.del {
  color: #999;
  background: #F5F5F5;
  border: 2rpx solid #ECECEC;
}

.cabinet-empty-hint {
  text-align: center;
  font-size: 26rpx;
  color: #B39AA7;
  padding: 40rpx 0;
}

/* ===== 列表 ===== */
.list {
  min-height: 200rpx;
}

.card {
  display: flex;
  background: rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(16rpx);
  border-radius: 32rpx;
  padding: 24rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 8rpx 26rpx rgba(255, 155, 181, 0.14);
  transition: transform 0.12s ease;
}

.card:active {
  transform: scale(0.98);
}

.card-image {
  width: 150rpx;
  height: 180rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #FFEDF2, #FFE0EA);
  flex-shrink: 0;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.8);
}

.card-image image {
  width: 100%;
  height: 100%;
}

.image-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-hanger {
  position: relative;
  width: 44rpx;
  height: 28rpx;
  border: 4rpx solid #FFB6C1;
  border-top: none;
  border-radius: 0 0 24rpx 24rpx;
}

.placeholder-hanger::before {
  content: '';
  position: absolute;
  top: -22rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 4rpx;
  height: 22rpx;
  background: #FFB6C1;
}

.placeholder-hanger::after {
  content: '';
  position: absolute;
  top: -26rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 12rpx;
  height: 10rpx;
  border: 4rpx solid #FFB6C1;
  border-bottom: none;
  border-radius: 12rpx 12rpx 0 0;
}

.card-content {
  flex: 1;
  padding-left: 22rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
  overflow: hidden;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 700;
  color: #5B3A48;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.brand {
  font-size: 22rpx;
  color: #B39AA7;
  flex-shrink: 0;
}

.card-body {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
  margin: 8rpx 0;
}

.color-tag {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 4rpx solid #FFE0EA;
  box-shadow: 0 2rpx 6rpx rgba(224, 90, 134, 0.2);
  flex-shrink: 0;
}

.price {
  font-size: 26rpx;
  color: #E05A86;
  font-weight: 700;
}

.type-tag {
  font-size: 20rpx;
  color: #B39AA7;
  background: #FFEDF2;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.card-footer {
  display: flex;
  justify-content: flex-end;
  align-items: center;
}

/* ===== 状态标签（统一：同款圆角/字重/字色模式，仅背景色变化） ===== */
.status-tag {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 500;
  padding: 6rpx 24rpx;
  border-radius: 32rpx;
  letter-spacing: 0.5rpx;
  line-height: 1.4;
  text-align: center;
}

.status-tag.today {
  background: var(--grad-rose);
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(255, 155, 181, 0.35);
  animation: breathe 1.8s ease-in-out infinite;
}

.status-tag.pending {
  color: #E05A86;
  background: #FFE4EC;
}

.status-tag.paid {
  color: #B39AA7;
  background: #F6EFF2;
}

.status-tag.stock {
  color: #5FA363;
  background: #EDF7EC;
}

@keyframes breathe {
  0%, 100% { opacity: 1; transform: scale(1); }
  50%      { opacity: 0.65; transform: scale(0.96); }
}

/* ===== 筛选抽屉内容 ===== */
.drawer-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.drawer-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.drawer-label {
  font-size: 23rpx;
  color: #A98E9C;
  letter-spacing: 1rpx;
}

.drawer-value {
  width: 100%;
  font-size: 26rpx;
  color: #5B3A48;
  font-weight: 600;
  background: #FFEDF2;
  border: 2rpx solid #FFDCE7;
  padding: 16rpx 12rpx;
  border-radius: 24rpx;
  text-align: center;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
