page {
  background: #FFF5F5;
  min-height: 100vh;
  padding-bottom: 160rpx;
}

.page {
  padding: 32rpx 28rpx;
}

/* ============ 用户卡片 ============ */
.user-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: linear-gradient(135deg, #FF8FA9 0%, #FF6B8A 100%);
  border-radius: 32rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 138, 0.25);
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

.avatar-emoji {
  font-size: 64rpx;
  line-height: 1;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  color: #FFFFFF;
  min-width: 0;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-id {
  font-size: 24rpx;
  opacity: 0.85;
}

.user-card-arrow {
  color: rgba(255, 255, 255, 0.8);
  font-size: 44rpx;
  font-weight: 200;
  line-height: 1;
}

/* ============ 设置卡片 ============ */
.settings-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 182, 193, 0.1);
  overflow: hidden;
}

.setting-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid #FBF5F7;
}

.setting-row:last-child {
  border-bottom: none;
}

.setting-row:active {
  background: #FFF5F5;
}

.setting-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.setting-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  flex-shrink: 0;
}

/* 不同功能的扁平化图标背景色 */
.icon-bell     { background: linear-gradient(135deg, #FFE0B2, #FFCC80); }
.icon-export   { background: linear-gradient(135deg, #B3E5FC, #81D4FA); }
.icon-import   { background: linear-gradient(135deg, #C8E6C9, #A5D6A7); }
.icon-feedback { background: linear-gradient(135deg, #FFCDD2, #EF9A9A); }
.icon-about    { background: linear-gradient(135deg, #E1BEE7, #CE93D8); }
.icon-contact  { background: linear-gradient(135deg, #F8BBD0, #F48FB1); }

/* CSS 绘制的扁平化图标 */
.icon-bell::before {
  content: '';
  width: 22rpx;
  height: 22rpx;
  border: 4rpx solid #FFFFFF;
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
  margin-top: -4rpx;
}
.icon-bell::after {
  content: '';
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #FFFFFF;
  bottom: 14rpx;
}

.icon-export::before {
  content: '';
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-top: 16rpx solid #FFFFFF;
  margin-bottom: 4rpx;
}
.icon-export::after {
  content: '';
  width: 6rpx;
  height: 18rpx;
  background: #FFFFFF;
  border-radius: 3rpx;
}

.icon-import::before {
  content: '';
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-bottom: 16rpx solid #FFFFFF;
  margin-top: 4rpx;
}
.icon-import::after {
  content: '';
  width: 6rpx;
  height: 18rpx;
  background: #FFFFFF;
  border-radius: 3rpx;
}

.icon-feedback::before {
  content: '';
  width: 26rpx;
  height: 18rpx;
  border: 4rpx solid #FFFFFF;
  border-radius: 4rpx;
  background: transparent;
}
.icon-feedback::after {
  content: '';
  position: absolute;
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 8rpx solid #FFFFFF;
  margin-top: 22rpx;
}

.icon-about::before {
  content: 'i';
  font-family: 'Georgia', serif;
  font-style: italic;
  font-weight: bold;
  font-size: 32rpx;
  color: #FFFFFF;
  line-height: 1;
}

.icon-contact::before {
  content: '';
  width: 28rpx;
  height: 20rpx;
  border: 4rpx solid #FFFFFF;
  border-radius: 4rpx;
}
.icon-contact::after {
  content: '';
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid #FFFFFF;
  border-right: 3rpx solid #FFFFFF;
  transform: rotate(135deg);
  margin-top: -10rpx;
}

.setting-label {
  font-size: 30rpx;
  color: #4A2A2A;
  font-weight: 500;
}

.setting-arrow {
  font-size: 36rpx;
  color: #CCC;
  font-weight: 200;
}

/* ============ 水印 ============ */
.footer-watermark {
  text-align: center;
  font-size: 24rpx;
  color: #BBB;
  margin-top: 60rpx;
  letter-spacing: 2rpx;
}

.modal-watermark {
  text-align: center;
  font-size: 22rpx;
  color: #BBB;
  margin: 8rpx 0;
  letter-spacing: 2rpx;
}

/* ============ 弹窗 ============ */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-box {
  width: 84%;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 48rpx 40rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #4A2A2A;
  margin-bottom: 4rpx;
}

.modal-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.7;
  white-space: pre-line;
  text-align: center;
}

.modal-btn {
  width: 100%;
  padding: 22rpx 0;
  text-align: center;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.modal-btn-primary {
  background: linear-gradient(135deg, #FFB6C1, #FF6B8A);
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 138, 0.25);
}

.modal-btn-text {
  color: #999;
  font-size: 26rpx;
}

/* 联系作者 - 联系方式卡片 */
.contact-card {
  width: 100%;
  background: #FFF5F5;
  border-radius: 20rpx;
  padding: 8rpx 0;
  margin: 8rpx 0;
}

.contact-row {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  gap: 16rpx;
}

.contact-row:active {
  background: #FFEBEF;
}

.contact-label {
  width: 100rpx;
  font-size: 26rpx;
  color: #999;
  flex-shrink: 0;
}

.contact-value {
  flex: 1;
  font-size: 28rpx;
  color: #FF6B8A;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.contact-action {
  font-size: 24rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, #FFB6C1, #FF6B8A);
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.contact-divider {
  height: 2rpx;
  background: #FBE5EA;
  margin: 0 28rpx;
}
