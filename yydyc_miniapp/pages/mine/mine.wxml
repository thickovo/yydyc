<!-- 背景图 -->
<image class="page-bg" src="/images/bg/mine-bg.jpg" mode="aspectFill"></image>
<view class="page-bg-overlay"></view>

<view class="page">
  <!-- 用户卡片 -->
  <view class="user-card ripple" bindtap="onTapProfile">
    <view class="avatar">
      <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill"></image>
      <text wx:else class="avatar-emoji">🌸</text>
    </view>
    <view class="user-info">
      <view class="nickname">{{nickname || '点击登录微信'}}</view>
    </view>
    <view class="user-card-arrow">
      <text>›</text>
    </view>
  </view>

  <!-- 消息提醒（弹性开关） -->
  <view class="settings-card">
    <view class="setting-row">
      <view class="setting-left">
        <view class="setting-icon icon-bell">
          <view class="bell-clapper"></view>
        </view>
        <text class="setting-label">消息提醒</text>
      </view>
      <view class="jelly-switch {{notifyEnabled ? 'on' : ''}}" bindtap="onToggleNotify">
        <view class="jelly-knob"></view>
      </view>
    </view>
  </view>

  <view class="settings-card">
    <view class="setting-row ripple" bindtap="onExport">
      <view class="setting-left">
        <view class="setting-icon icon-export"></view>
        <text class="setting-label">导出数据</text>
      </view>
      <text class="setting-arrow">›</text>
    </view>
    <view class="setting-row ripple" bindtap="onImport">
      <view class="setting-left">
        <view class="setting-icon icon-import"></view>
        <text class="setting-label">导入数据</text>
      </view>
      <text class="setting-arrow">›</text>
    </view>
  </view>

  <view class="settings-card">
    <view class="setting-row ripple" bindtap="onFeedback">
      <view class="setting-left">
        <view class="setting-icon icon-feedback"></view>
        <text class="setting-label">意见反馈</text>
      </view>
      <text class="setting-arrow">›</text>
    </view>
    <view class="setting-row ripple" bindtap="onAbout">
      <view class="setting-left">
        <view class="setting-icon icon-about"></view>
        <text class="setting-label">关于 DressNest</text>
      </view>
      <text class="setting-arrow">›</text>
    </view>
    <view class="setting-row ripple" bindtap="onContact">
      <view class="setting-left">
        <view class="setting-icon icon-contact"></view>
        <text class="setting-label">联系作者</text>
      </view>
      <text class="setting-arrow">›</text>
    </view>
  </view>

  <view class="mine-footer">
    <text class="mine-footer-heart">♡</text>
    <text class="mine-footer-text">DressNest · Th1ckovo</text>
    <text class="mine-footer-heart">♡</text>
  </view>
</view>

<!-- 关于：底部抽屉 -->
<view class="drawer-mask {{showAbout ? 'show' : ''}}" catchtap="onCloseAbout"></view>
<view class="drawer {{showAbout ? 'show' : ''}}">
  <view class="drawer-handle"></view>
  <view class="drawer-title">♡ 关于 DressNest</view>
  <view class="drawer-body">
    <view class="about-content">
      衣藏世间欢喜，裙角载满温柔。
      {{'\n\n'}}
      DressNest 是一个记录裙子与心意的轻量工具。
      {{'\n\n'}}
      这里没有复杂的表单，只有简单温柔的记录方式 —— 把每一件心爱的衣裳、每一份小小心愿都好好收藏。
      {{'\n\n'}}
      愿你穿喜欢的衣裳，做喜欢的事。
    </view>
  </view>
  <view class="drawer-actions">
    <view class="drawer-btn primary ripple" bindtap="onCloseAbout">知道了</view>
  </view>
</view>

<!-- 联系作者：底部抽屉 -->
<view class="drawer-mask {{showContact ? 'show' : ''}}" catchtap="onCloseContact"></view>
<view class="drawer {{showContact ? 'show' : ''}}">
  <view class="drawer-handle"></view>
  <view class="drawer-title">✉ 联系作者</view>
  <view class="drawer-body">
    <view class="about-content about-center">欢迎交流，一起把 DressNest 变得更好 ✨</view>

    <view class="contact-card">
      <view class="contact-row ripple" bindtap="onCopyWechat">
        <view class="contact-label">微信号</view>
        <view class="contact-value">{{wechat}}</view>
        <view class="contact-action ripple">复制</view>
      </view>
      <view class="contact-divider"></view>
      <view class="contact-row ripple" bindtap="onCopyEmail">
        <view class="contact-label">邮箱</view>
        <view class="contact-value">{{email}}</view>
        <view class="contact-action ripple">复制</view>
      </view>
    </view>

    <view class="modal-watermark">作者：Th1ckovo</view>
  </view>
  <view class="drawer-actions">
    <view class="drawer-btn primary ripple" bindtap="onCloseContact">关闭</view>
  </view>
</view>
