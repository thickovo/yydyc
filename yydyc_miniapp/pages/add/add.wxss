page {
  background: #FFF5F5;
  padding: 24rpx;
  padding-bottom: 60rpx;
  overflow-x: hidden;
}

/* ===== 表单区块 ===== */
.form-section {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 28rpx 28rpx 10rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 182, 193, 0.08);
  overflow: hidden;
}

.form-item {
  margin-bottom: 26rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-item .label {
  display: block;
  font-size: 26rpx;
  font-weight: bold;
  color: #4A2A2A;
  margin-bottom: 12rpx;
}

/* ===== 输入框 ===== */
.form-item input {
  width: 100%;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #F0E0E4;
  font-size: 28rpx;
  color: #4A2A2A;
  box-sizing: border-box;
}

.form-item input::placeholder {
  color: #CCC;
}

.picker-display {
  width: 100%;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #F0E0E4;
  font-size: 28rpx;
  color: #4A2A2A;
  box-sizing: border-box;
}

.picker-display.placeholder {
  color: #CCC;
}

/* ===== 图片上传 ===== */
.image-upload {
  position: relative;
  width: 100%;
  height: 360rpx;
  border-radius: 24rpx;
  background: #FFF5F7;
  border: 2rpx dashed #FFB6C1;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.image-upload:active {
  opacity: 0.85;
  transform: scale(0.99);
}

.image-upload.has-image {
  border-style: solid;
  border-color: #FFB6C1;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.upload-icon {
  font-size: 64rpx;
  opacity: 0.7;
}

.upload-text {
  font-size: 28rpx;
  color: #FF6B8A;
  font-weight: 500;
}

.upload-hint {
  font-size: 22rpx;
  color: #BBB;
}

.upload-preview {
  width: 100%;
  height: 100%;
}

.upload-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0));
  display: flex;
  justify-content: center;
  align-items: flex-end;
}

.upload-mask-text {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.image-remove {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 48rpx;
  height: 48rpx;
  background: rgba(0, 0, 0, 0.55);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-remove:active {
  opacity: 0.7;
}

.image-remove-text {
  color: #FFFFFF;
  font-size: 32rpx;
  line-height: 1;
  font-weight: 300;
}

/* ===== 颜色选择 ===== */
.color-group {
  display: flex;
  gap: 18rpx;
  padding: 12rpx 0;
  flex-wrap: wrap;
}

.color-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 3rpx solid #E8E0E4;
  flex-shrink: 0;
}

.color-dot.active {
  border: 5rpx solid #FF6B8A;
  transform: scale(1.15);
  box-shadow: 0 0 24rpx rgba(255, 107, 138, 0.5);
}

/* ===== 模式切换 & 提醒 ===== */
.mode-switch,
.remind-group {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  padding: 6rpx 0;
}

.switch-option {
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #999;
  background: #F5F0F2;
  transition: all 0.2s;
}

.switch-option.active {
  color: #FFFFFF;
  background: linear-gradient(135deg, #FFB6C1, #FF6B8A);
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 138, 0.3);
}

/* ===== 小物标签 ===== */
.accessories-group {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 6rpx 0;
}

.accessory-tag {
  padding: 10rpx 22rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  color: #999;
  background: #F5F0F2;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.accessory-tag.active {
  color: #FFFFFF;
  background: #FF6B8A;
  border-color: #FF6B8A;
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 138, 0.3);
}

.custom-accessory {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  align-items: center;
}

.custom-accessory .input {
  flex: 1;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #F0E0E4;
  font-size: 26rpx;
  color: #4A2A2A;
  box-sizing: border-box;
}

.add-custom-btn {
  background: #FF6B8A;
  border-radius: 28rpx;
  padding: 10rpx 24rpx;
  flex-shrink: 0;
}

.add-custom-btn:active {
  opacity: 0.8;
}

.add-custom-text {
  font-size: 24rpx;
  color: #FFFFFF;
}

/* ===== 备注 ===== */
.form-item textarea {
  width: 100%;
  height: 140rpx;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #F0E0E4;
  font-size: 28rpx;
  color: #4A2A2A;
  resize: none;
  box-sizing: border-box;
}

.form-item textarea::placeholder {
  color: #CCC;
}

/* ===== 保存按钮 ===== */
.btn-wrap {
  margin-top: 12rpx;
}

.save-btn {
  width: 100%;
  background: linear-gradient(135deg, #FFB6C1, #FF6B8A) !important;
  color: #FFFFFF !important;
  font-size: 32rpx;
  font-weight: bold;
  padding: 24rpx 0;
  border: none;
  border-radius: 48rpx;
  box-shadow: 0 6rpx 24rpx rgba(255, 107, 138, 0.3);
}

.save-btn:active {
  transform: scale(0.97);
}
