page {
  background: #FFF5F5;
  padding: 32rpx;
  padding-top: 80rpx;
  overflow-x: hidden;
}

/* ===== 顶部导航 ===== */
.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0 32rpx 0;
}

.top-left {
  display: flex;
  align-items: center;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #4A2A2A;
}

.bell {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  background: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(255, 182, 193, 0.15);
}

.bell-icon {
  font-size: 36rpx;
}

.badge {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 16rpx;
  height: 16rpx;
  background: #FF6B8A;
  border-radius: 50%;
  border: 3rpx solid #FFF5F5;
}

/* ===== 横幅 ===== */
.banner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #FFB6C1 0%, #FF9BB5 100%);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 6rpx 24rpx rgba(255, 107, 138, 0.2);
  overflow: hidden;
}

.banner-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
  min-width: 0;
}

.banner-text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 500;
  text-shadow: 0 2rpx 8rpx rgba(255, 107, 138, 0.3);
  white-space: nowrap;
}

.banner-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.4);
}

/* ===== 统计卡片 ===== */
.stats {
  display: flex;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 32rpx 0;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 182, 193, 0.12);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  position: relative;
}

.stat-number {
  font-size: 44rpx;
  font-weight: bold;
  color: #4A2A2A;
  position: relative;
  z-index: 1;
}

.stat-number.pending {
  color: #FF6B8A;
  animation: breathe 1.8s ease-in-out infinite;
}

.stat-number.paid {
  color: #7BC67E;
}

@keyframes breathe {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.6; transform: scale(0.95); }
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.stat-icon-bg {
  font-size: 52rpx;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  opacity: 0.08;
  z-index: 0;
}

/* ===== 滚动提示条 ===== */
.scroll-bar {
  background: linear-gradient(135deg, #FFE4E8 0%, #FFF0F3 100%);
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 32rpx;
  overflow: hidden;
  border: 2rpx solid rgba(255, 107, 138, 0.15);
}

.scroll-inner {
  white-space: nowrap;
  overflow: hidden;
}

.scroll-text {
  font-size: 24rpx;
  color: #E85A7A;
  display: inline-block;
  animation: scrollLeft 10s linear infinite;
}

@keyframes scrollLeft {
  0% { transform: translateX(100vw); }
  100% { transform: translateX(-100%); }
}

/* ===== 区域标题 ===== */
.section-title {
  margin-bottom: 22rpx;
  margin-top: 8rpx;
}

.section-title-text {
  font-size: 30rpx;
  font-weight: bold;
  color: #4A2A2A;
}

/* ===== 2×2 功能卡片 ===== */
.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 22rpx;
}

.grid-item {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 32rpx 22rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 182, 193, 0.10);
  position: relative;
  overflow: hidden;
}

.grid-item:active {
  transform: scale(0.96);
  transition: transform 0.15s ease;
}

.grid-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.grid-icon-closet {
  background: linear-gradient(135deg, #FFE4EC, #FFD0DC);
}

.grid-icon-wish {
  background: linear-gradient(135deg, #E8D5FF, #D6C0FF);
}

.grid-icon-calendar {
  background: linear-gradient(135deg, #D4F0FF, #BFE4FF);
}

.grid-icon-account {
  background: linear-gradient(135deg, #FFF3D0, #FFE8B0);
}

.grid-icon {
  font-size: 44rpx;
}

.grid-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #4A2A2A;
  margin-top: 6rpx;
}

.grid-desc {
  font-size: 22rpx;
  color: #BBB;
}
