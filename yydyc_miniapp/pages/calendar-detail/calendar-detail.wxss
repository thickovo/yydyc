page {
  background: #FFF7F9;
  min-height: 100vh;
  padding-bottom: 160rpx;
}

.page {
  padding: 28rpx 24rpx;
}

/* ============ 汇总卡 ============ */
.summary-card {
  background: linear-gradient(135deg, #FFB6C1 0%, #FF9BB5 100%);
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 155, 181, 0.25);
  color: #FFFFFF;
}

.date-text {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 16rpx;
}

.amount-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.amount-label {
  font-size: 26rpx;
  opacity: 0.9;
}

.amount-num {
  font-size: 56rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}

.count-row {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 12rpx;
}

/* ============ 区域标题 ============ */
.section-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #E05A86;
  margin-bottom: 22rpx;
  padding-left: 18rpx;
  position: relative;
  letter-spacing: 2rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 26rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #FFB6C1, #FF9BB5);
}

.loading-tip, .empty-tip {
  text-align: center;
  color: #BBB;
  font-size: 26rpx;
  padding: 80rpx 0;
}

/* ============ 列表 ============ */
.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.item-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 182, 193, 0.1);
}

.item-card:active {
  transform: scale(0.99);
  background: #FFF5F7;
}

.item-image {
  width: 100rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background: #F5EEF0;
  flex-shrink: 0;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.item-image image {
  width: 100%;
  height: 100%;
}

.image-placeholder {
  font-size: 40rpx;
}

.item-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #4A2A2A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-brand {
  font-size: 22rpx;
  color: #999;
}

.item-tag {
  display: inline-block;
  font-size: 20rpx;
  color: #E05A86;
  background: #FFEDF2;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  align-self: flex-start;
  margin-top: 2rpx;
}

.item-amount {
  font-size: 30rpx;
  font-weight: bold;
  color: #E05A86;
  flex-shrink: 0;
}

/* ===== DressNest 主题层 ===== */
.page, .form, .detail-page, .loading {
  position: relative;
  z-index: 2;
}

.glass {
  background: rgba(255, 255, 255, 0.92) !important;
  backdrop-filter: blur(16rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.95) !important;
  box-shadow: 0 8rpx 26rpx rgba(255, 155, 181, 0.14) !important;
  border-radius: 32rpx;
}
.summary-card, .item-card {
  background: rgba(255, 255, 255, 0.92) !important;
  backdrop-filter: blur(16rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 8rpx 26rpx rgba(255, 155, 181, 0.14);
  border-radius: 32rpx;
}
