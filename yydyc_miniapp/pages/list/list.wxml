<!-- 搜索栏 -->
<view class="search-bar">
  <view class="search-input-wrap">
    <text class="search-icon">🔍</text>
    <input class="search-input" placeholder="搜索裙子名称或品牌" value="{{keyword}}" bindinput="onKeywordInput" />
  </view>
  <view class="filter-toggle" bindtap="toggleFilter">
    <text class="filter-toggle-text">筛选</text>
  </view>
</view>

<!-- 筛选栏 -->
<view class="filter-bar" wx:if="{{showFilter}}">
  <view class="filter-row">
    <view class="filter-item">
      <text class="filter-label">类别</text>
      <picker mode="selector" range="{{categoryOptions}}" bindchange="onCategoryChange">
        <view class="filter-value">{{category || '全部'}}</view>
      </picker>
    </view>
    <view class="filter-item">
      <text class="filter-label">类型</text>
      <picker mode="selector" range="{{typeOptions}}" bindchange="onTypeChange">
        <view class="filter-value">{{type || '全部'}}</view>
      </picker>
    </view>
    <view class="filter-item">
      <text class="filter-label">颜色</text>
      <picker mode="selector" range="{{colorLabels}}" bindchange="onColorChange">
        <view class="filter-value">{{colorLabels[colorOptions.indexOf(color)] || '全部'}}</view>
      </picker>
    </view>
    <view class="filter-item">
      <text class="filter-label">状态</text>
      <picker mode="selector" range="{{statusOptions}}" bindchange="onStatusChange">
        <view class="filter-value">{{statusOptions[statusKeys.indexOf(status)] || '全部'}}</view>
      </picker>
    </view>
  </view>
  <view class="filter-clear" wx:if="{{keyword || category || type || color || status}}" bindtap="clearFilter">
    <text class="filter-clear-text">清除筛选</text>
  </view>
</view>

<!-- 添加按钮 -->
<view class="add-btn" bindtap="goToAdd">
  <text class="add-btn-text">+ 添加裙子</text>
</view>

<!-- 列表 -->
<view class="list" wx:if="{{filteredSkirts.length > 0}}">
  <view class="card" wx:for="{{filteredSkirts}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
    <view class="card-image">
      <image wx:if="{{item.displayImageUrl}}" src="{{item.displayImageUrl}}" mode="aspectFill"></image>
      <view wx:else class="image-placeholder">👗</view>
    </view>
    <view class="card-content">
      <view class="card-header">
        <text class="name">{{item.name}}</text>
        <text class="brand">{{item.brand}}</text>
      </view>
      <view class="card-body">
        <view wx:if="{{item.color}}" class="color-tag" style="background: {{item.color}};"></view>
        <text class="price">¥{{item.totalPrice}}</text>
        <text class="type-tag" wx:if="{{item.type}}">{{item.type}}</text>
      </view>
      <view class="card-footer">
        <text class="status-tag {{item.statusClass}}">{{item.statusText}}</text>
      </view>
    </view>
  </view>
</view>

<!-- 空状态 -->
<view class="empty" wx:if="{{allSkirts.length > 0 && filteredSkirts.length === 0}}">
  <text class="empty-icon">🎀</text>
  <text class="empty-text">没有找到匹配的裙子</text>
</view>

<view class="empty" wx:if="{{allSkirts.length === 0}}">
  <text class="empty-icon">👗</text>
  <text class="empty-text">衣橱还是空的，快去添加吧～</text>
</view>
