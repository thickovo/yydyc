page {
  background: #FFF7F9;
  padding: 24rpx;
  padding-bottom: 60rpx;
  overflow-x: hidden;
}

/* ===== 表单区块 ===== */
.form-section {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 32rpx 28rpx 12rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 182, 193, 0.08);
  overflow: hidden;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-item .label {
  display: block;
  font-size: 26rpx;
  font-weight: bold;
  color: #4A2A2A;
  margin-bottom: 14rpx;
}

/* ===== 输入框：显式高度 + line-height，修复文字显示不全 ===== */
.form-item input {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  border-bottom: 2rpx solid #F0E0E4;
  font-size: 28rpx;
  color: #4A2A2A;
  box-sizing: border-box;
  background: transparent;
}

.form-item input::placeholder {
  color: #CCC;
}

.input-price {
  font-weight: 600;
  color: #E05A86;
}

.picker-display {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  border-bottom: 2rpx solid #F0E0E4;
  font-size: 28rpx;
  color: #4A2A2A;
  box-sizing: border-box;
}

.picker-display.placeholder {
  color: #CCC;
}

.cabinet-tip {
  font-size: 22rpx;
  color: #B39AA7;
  margin-top: 8rpx;
}

/* ===== 图片上传：紧凑左图右输入（与列表卡片 image 同比例 150:180） ===== */
.upload-row {
  display: flex;
  gap: 28rpx;
  align-items: stretch;
}

.image-upload {
  position: relative;
  width: 220rpx;
  aspect-ratio: 150 / 180;
  flex-shrink: 0;
  border-radius: 20rpx;
  background: #FFF7F9;
  border: 2rpx dashed #FFD3DE;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.image-upload:active {
  opacity: 0.85;
  transform: scale(0.99);
}

.image-upload.has-image {
  border-style: solid;
  border-color: #FFD3DE;
}

.upload-side {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.upload-side .input {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  border-bottom: 2rpx solid #F0E0E4;
  font-size: 28rpx;
  color: #4A2A2A;
  box-sizing: border-box;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.upload-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 200;
  color: #E05A86;
  box-shadow: 0 4rpx 12rpx rgba(255, 155, 181, 0.2);
}

.upload-text {
  font-size: 22rpx;
  color: #E05A86;
  font-weight: 500;
}

.upload-preview {
  width: 100%;
  height: 100%;
  display: block;
}

.upload-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0));
  display: flex;
  justify-content: center;
  align-items: flex-end;
}

.upload-mask-text {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.image-remove {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 48rpx;
  height: 48rpx;
  background: rgba(0, 0, 0, 0.55);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-remove:active {
  opacity: 0.7;
}

.image-remove-text {
  color: #FFFFFF;
  font-size: 32rpx;
  line-height: 1;
  font-weight: 300;
}

/* ===== 颜色选择 ===== */
.color-group {
  display: flex;
  gap: 18rpx;
  padding: 12rpx 0;
  flex-wrap: wrap;
}

.color-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 3rpx solid #E8E0E4;
  flex-shrink: 0;
}

.color-dot.active {
  border: 5rpx solid #FF9BB5;
  transform: scale(1.15);
  box-shadow: 0 0 24rpx rgba(255, 155, 181, 0.5);
}

/* ===== 模式切换 & 提醒 ===== */
.mode-switch,
.remind-group {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  padding: 6rpx 0;
}

.switch-option {
  padding: 14rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #999;
  background: #F5F0F2;
  transition: all 0.2s;
}

.switch-option.active {
  color: #FFFFFF;
  background: linear-gradient(135deg, #FFB6C1, #FF9BB5);
  box-shadow: 0 4rpx 12rpx rgba(255, 155, 181, 0.3);
}

/* ===== 小物标签 ===== */
.accessories-group {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 6rpx 0;
}

.accessory-tag {
  padding: 12rpx 22rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  color: #999;
  background: #F5F0F2;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.accessory-tag.active {
  color: #FFFFFF;
  background: #FF9BB5;
  border-color: #E05A86;
  box-shadow: 0 2rpx 8rpx rgba(255, 155, 181, 0.3);
}

.custom-accessory {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  align-items: center;
}

.custom-accessory .input {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  border-bottom: 2rpx solid #F0E0E4;
  font-size: 26rpx;
  color: #4A2A2A;
  box-sizing: border-box;
}

.add-custom-btn {
  background: linear-gradient(135deg, #FFB6C1, #FF9BB5);
  border-radius: 28rpx;
  padding: 14rpx 28rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 10rpx rgba(255, 155, 181, 0.25);
}

.add-custom-btn:active {
  opacity: 0.85;
  transform: scale(0.97);
}

.add-custom-text {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 500;
}

/* ===== 现货提示 ===== */
.stock-tip {
  background: #FFF7F9;
  border-left: 6rpx solid #FF9BB5;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #888;
  line-height: 1.6;
}

/* ===== 备注 ===== */
.form-item textarea {
  width: 100%;
  min-height: 140rpx;
  line-height: 1.6;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #F0E0E4;
  font-size: 28rpx;
  color: #4A2A2A;
  box-sizing: border-box;
}

.form-item textarea::placeholder {
  color: #CCC;
}

/* ===== 保存按钮 ===== */
.btn-wrap {
  margin-top: 16rpx;
}

.save-btn {
  width: 100%;
  background: linear-gradient(135deg, #FFB6C1, #FF9BB5) !important;
  color: #FFFFFF !important;
  font-size: 32rpx;
  font-weight: bold;
  padding: 24rpx 0;
  border: none;
  border-radius: 48rpx;
  box-shadow: 0 6rpx 24rpx rgba(255, 155, 181, 0.3);
}

.save-btn:active {
  transform: scale(0.97);
}

/* ===== DressNest 主题层 ===== */
.page, .form, .detail-page, .loading {
  position: relative;
  z-index: 2;
}

.glass {
  background: rgba(255, 255, 255, 0.92) !important;
  backdrop-filter: blur(16rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.95) !important;
  box-shadow: 0 8rpx 26rpx rgba(255, 155, 181, 0.14) !important;
  border-radius: 32rpx;
}
.form-section {
  background: rgba(255, 255, 255, 0.92) !important;
  backdrop-filter: blur(16rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 8rpx 26rpx rgba(255, 155, 181, 0.14);
  border-radius: 32rpx;
}
