page {
  background: #FFF7F9;
  min-height: 100vh;
}

.page {
  position: relative;
  z-index: 2;
  padding: 24rpx 28rpx 200rpx;
}

/* ============ 头部 ============ */
.page-head {
  text-align: center;
  margin-bottom: 24rpx;
  padding: 8rpx 4rpx;
}

.page-title-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #5B3A48;
  letter-spacing: 4rpx;
}

.title-deco {
  width: 40rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: linear-gradient(90deg, rgba(255, 194, 214, 0), #FFB6C1);
}

.title-deco:last-child {
  background: linear-gradient(90deg, #FFB6C1, rgba(255, 194, 214, 0));
}

.page-sub {
  font-size: 24rpx;
  color: #B39AA7;
  letter-spacing: 2rpx;
}

/* ============ 搜索栏 ============ */
.search-bar {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.88);
  border: 2rpx solid rgba(255, 255, 255, 0.95);
  border-radius: 44rpx;
  padding: 18rpx 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(255, 155, 181, 0.12);
  backdrop-filter: blur(16rpx);
}

.search-icon {
  width: 22rpx;
  height: 22rpx;
  border: 3rpx solid #D8A9BC;
  border-radius: 50%;
  margin-right: 16rpx;
  position: relative;
  flex-shrink: 0;
}

.search-icon::after {
  content: '';
  position: absolute;
  bottom: -7rpx;
  right: -5rpx;
  width: 8rpx;
  height: 3rpx;
  background: #D8A9BC;
  border-radius: 2rpx;
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #5B3A48;
  height: 40rpx;
}

/* ============ 卡片 ============ */
.card {
  display: flex;
  align-items: stretch;
  gap: 20rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(16rpx);
  border-radius: 32rpx;
  padding: 24rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 8rpx 26rpx rgba(255, 155, 181, 0.14);
  transition: opacity 0.3s;
}

.card-done {
  opacity: 0.6;
}

.card-done .name {
  text-decoration: line-through;
  color: #B5A0AA;
}

/* ============ 弹性勾选（果冻圆钮） ============ */
.wish-check {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #FFF3F6;
  border: 3rpx solid #FFB6C1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
  transition: background 0.35s ease, border-color 0.35s ease, transform 0.4s cubic-bezier(0.3, 1.8, 0.5, 1);
}

.wish-check.checked {
  background: var(--grad-rose);
  border-color: #E05A86;
  box-shadow: 0 6rpx 16rpx rgba(255, 155, 181, 0.45);
  transform: scale(1.08);
}

.wish-check:active {
  transform: scale(0.82);
}

.wish-check.checked:active {
  transform: scale(0.9);
}

.wish-check-knob {
  display: flex;
  align-items: center;
  justify-content: center;
}

.check-tick {
  width: 10rpx;
  height: 18rpx;
  border-right: 4rpx solid #FFFFFF;
  border-bottom: 4rpx solid #FFFFFF;
  transform: rotate(45deg);
  margin-top: -4rpx;
  animation: tickPop 0.45s cubic-bezier(0.3, 1.8, 0.5, 1);
}

@keyframes tickPop {
  0%   { transform: rotate(45deg) scale(0); }
  70%  { transform: rotate(45deg) scale(1.4); }
  100% { transform: rotate(45deg) scale(1); }
}

.card-image {
  width: 150rpx;
  height: 180rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #FFEDF2, #F3E8FA);
  flex-shrink: 0;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.8);
}

.card-image image {
  width: 100%;
  height: 100%;
}

.image-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-heart {
  position: relative;
  width: 40rpx;
  height: 36rpx;
}

.placeholder-heart::before,
.placeholder-heart::after {
  content: '';
  position: absolute;
  top: 0;
  width: 22rpx;
  height: 36rpx;
  background: linear-gradient(135deg, #FFB6C1, #FF9BB5);
  border-radius: 22rpx 22rpx 0 0;
}

.placeholder-heart::before { left: 0; transform: rotate(-45deg); transform-origin: 100% 100%; }
.placeholder-heart::after { right: 0; transform: rotate(45deg); transform-origin: 0 100%; }

.card-content {
  flex: 1;
  padding-left: 4rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
  min-width: 0;
}

.name-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 700;
  color: #5B3A48;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}

.brand {
  font-size: 22rpx;
  color: #B39AA7;
  flex-shrink: 0;
}

.price-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.price {
  font-size: 26rpx;
  color: #E05A86;
  font-weight: 700;
}

.link {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #E05A86;
  background: #FFE4EC;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}

.link-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #E05A86;
}

.meta-row {
  display: flex;
  align-items: center;
}

.meta-text {
  font-size: 22rpx;
  color: #B39AA7;
}

.note {
  font-size: 24rpx;
  color: #A98E9C;
  background: #FFF3F6;
  border-left: 5rpx solid #FFB6C1;
  padding: 8rpx 16rpx;
  border-radius: 14rpx;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* ============ 添加悬浮按钮 ============ */
.add-fab {
  position: fixed;
  right: 40rpx;
  bottom: 180rpx;
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  background: var(--grad-rose);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(255, 155, 181, 0.45);
  z-index: 100;
  transition: transform 0.2s cubic-bezier(0.3, 1.6, 0.5, 1);
}

.add-fab:active {
  transform: scale(0.88);
}

.add-fab-plus {
  width: 34rpx;
  height: 34rpx;
  position: relative;
}

.add-fab-plus::before,
.add-fab-plus::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: #FFFFFF;
  border-radius: 3rpx;
}

.add-fab-plus::before { width: 30rpx; height: 5rpx; }
.add-fab-plus::after { width: 5rpx; height: 30rpx; }
