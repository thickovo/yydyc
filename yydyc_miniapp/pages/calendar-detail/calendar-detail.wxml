<image class="page-bg" src="/images/bg/calendar-bg.jpg" mode="aspectFill"></image>
<view class="page-bg-overlay"></view>

<view class="page">
  <!-- 顶部汇总卡 -->
  <view class="summary-card">
    <view class="date-text">{{dateText}}</view>
    <view class="amount-row">
      <text class="amount-label">总支出</text>
      <text class="amount-num">¥{{totalAmount}}</text>
    </view>
    <view class="count-row">共 {{count}} 笔记录</view>
  </view>

  <!-- 列表 -->
  <view class="section-title">购买记录</view>

  <view wx:if="{{loading}}" class="loading-tip">加载中...</view>

  <view wx:elif="{{items.length === 0}}" class="sakura-empty-block">
    <view class="sakura-empty-illust">
      <view class="sub-sakura sub-1">
        <view class="sakura size-sm">
          <view class="sakura-petal" style="transform: translate(-50%, -100%) rotate(0deg) translateY(-15rpx);"></view>
          <view class="sakura-petal" style="transform: translate(-50%, -100%) rotate(72deg) translateY(-15rpx);"></view>
          <view class="sakura-petal" style="transform: translate(-50%, -100%) rotate(144deg) translateY(-15rpx);"></view>
          <view class="sakura-petal" style="transform: translate(-50%, -100%) rotate(216deg) translateY(-15rpx);"></view>
          <view class="sakura-petal" style="transform: translate(-50%, -100%) rotate(288deg) translateY(-15rpx);"></view>
          <view class="sakura-center"></view>
        </view>
      </view>
      <view class="main-sakura">
        <view class="sakura size-md">
          <view class="sakura-petal" style="transform: translate(-50%, -100%) rotate(0deg) translateY(-30rpx);"></view>
          <view class="sakura-petal" style="transform: translate(-50%, -100%) rotate(72deg) translateY(-30rpx);"></view>
          <view class="sakura-petal" style="transform: translate(-50%, -100%) rotate(144deg) translateY(-30rpx);"></view>
          <view class="sakura-petal" style="transform: translate(-50%, -100%) rotate(216deg) translateY(-30rpx);"></view>
          <view class="sakura-petal" style="transform: translate(-50%, -100%) rotate(288deg) translateY(-30rpx);"></view>
          <view class="sakura-center"></view>
        </view>
      </view>
      <view class="sub-sakura sub-2">
        <view class="sakura size-sm">
          <view class="sakura-petal" style="transform: translate(-50%, -100%) rotate(0deg) translateY(-15rpx);"></view>
          <view class="sakura-petal" style="transform: translate(-50%, -100%) rotate(72deg) translateY(-15rpx);"></view>
          <view class="sakura-petal" style="transform: translate(-50%, -100%) rotate(144deg) translateY(-15rpx);"></view>
          <view class="sakura-petal" style="transform: translate(-50%, -100%) rotate(216deg) translateY(-15rpx);"></view>
          <view class="sakura-petal" style="transform: translate(-50%, -100%) rotate(288deg) translateY(-15rpx);"></view>
          <view class="sakura-center"></view>
        </view>
      </view>
    </view>
    <view class="sakura-empty-text">当日暂无支出记录{{'\n'}}这里安安静静的~</view>
  </view>

  <view wx:else class="list">
    <view class="item-card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="onTapItem">
      <view class="item-image">
        <image wx:if="{{item.displayImageUrl}}" src="{{item.displayImageUrl}}" mode="aspectFill"></image>
        <view wx:else class="image-placeholder">👗</view>
      </view>
      <view class="item-content">
        <view class="item-name">{{item.name}}</view>
        <view class="item-brand" wx:if="{{item.brand}}">{{item.brand}}</view>
        <view class="item-tag" wx:if="{{item.type}}">{{item.type}}</view>
      </view>
      <view class="item-amount">¥{{item.amount}}</view>
    </view>
  </view>
</view>
