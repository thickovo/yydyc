page {
  background: #FFF7F9;
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.form-section {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 32rpx 28rpx 12rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 182, 193, 0.08);
}

.form-item {
  margin-bottom: 32rpx;
}

.form-item .label {
  display: block;
  font-size: 26rpx;
  font-weight: bold;
  color: #4A2A2A;
  margin-bottom: 14rpx;
}

.form-item input {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  border-bottom: 2rpx solid #F0E0E4;
  font-size: 28rpx;
  color: #4A2A2A;
  box-sizing: border-box;
}

.form-item input::placeholder {
  color: #CCC;
}

.input-price {
  font-weight: 600;
  color: #E05A86;
}

.form-item textarea {
  width: 100%;
  min-height: 140rpx;
  line-height: 1.6;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #F0E0E4;
  font-size: 28rpx;
  color: #4A2A2A;
  box-sizing: border-box;
}

/* 图片上传：紧凑左图右输入 */
.upload-row {
  display: flex;
  gap: 28rpx;
  align-items: stretch;
}

.image-upload {
  position: relative;
  width: 220rpx;
  aspect-ratio: 150 / 180;
  flex-shrink: 0;
  border-radius: 20rpx;
  background: #FFF7F9;
  border: 2rpx dashed #FFD3DE;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-upload.has-image {
  border-style: solid;
  border-color: #FFD3DE;
}

.upload-side {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.upload-side .input {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  border-bottom: 2rpx solid #F0E0E4;
  font-size: 28rpx;
  color: #4A2A2A;
  box-sizing: border-box;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.upload-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 200;
  color: #E05A86;
  box-shadow: 0 4rpx 12rpx rgba(255, 155, 181, 0.2);
}

.upload-text {
  font-size: 22rpx;
  color: #E05A86;
  font-weight: 500;
}

.upload-preview {
  width: 100%;
  height: 100%;
}

.upload-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0));
  text-align: center;
}

.upload-mask-text {
  font-size: 24rpx;
  color: #FFFFFF;
}

.image-remove {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 48rpx;
  height: 48rpx;
  background: rgba(0, 0, 0, 0.55);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-remove-text {
  color: #FFFFFF;
  font-size: 32rpx;
  line-height: 1;
}

/* 保存按钮 */
.btn-wrap {
  margin-top: 16rpx;
}

.save-btn {
  width: 100%;
  background: linear-gradient(135deg, #FFB6C1, #FF9BB5) !important;
  color: #FFFFFF !important;
  font-size: 32rpx;
  font-weight: bold;
  padding: 24rpx 0;
  border: none;
  border-radius: 48rpx;
  box-shadow: 0 6rpx 24rpx rgba(255, 155, 181, 0.3);
}

/* ===== DressNest 主题层 ===== */
.page, .form, .detail-page, .loading {
  position: relative;
  z-index: 2;
}

.glass {
  background: rgba(255, 255, 255, 0.92) !important;
  backdrop-filter: blur(16rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.95) !important;
  box-shadow: 0 8rpx 26rpx rgba(255, 155, 181, 0.14) !important;
  border-radius: 32rpx;
}
.form-section {
  background: rgba(255, 255, 255, 0.92) !important;
  backdrop-filter: blur(16rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 8rpx 26rpx rgba(255, 155, 181, 0.14);
  border-radius: 32rpx;
}
