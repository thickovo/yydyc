<image class="page-bg" src="/images/bg/detail-bg.jpg" mode="aspectFill"></image>
<view class="page-bg-overlay"></view>

<block wx:if="{{skirt}}">
  <view class="detail-page">
  <!-- 图片轮播 -->
  <view class="hero-photo">
    <swiper
      wx:if="{{swiperImages.length > 0}}"
      class="hero-swiper"
      indicator-dots="{{swiperImages.length > 1}}"
      indicator-color="rgba(255,255,255,0.35)"
      indicator-active-color="#FFFFFF"
      current="{{current}}"
      bindchange="onSwiperChange"
      circular
    >
      <swiper-item wx:for="{{swiperImages}}" wx:key="*this">
        <block wx:if="{{!failedImages[item]}}">
          <image
            class="hero-swiper-img"
            src="{{item}}"
            mode="aspectFit"
            binderror="onHeroImageError"
            data-url="{{item}}"
          ></image>
        </block>
        <view wx:else class="hero-swiper-failed">
          <view class="placeholder-hanger"></view>
        </view>
      </swiper-item>
    </swiper>
    <view wx:else class="hero-photo-placeholder">
      <view class="placeholder-hanger"></view>
    </view>
  </view>

  <!-- 顶部信息卡 -->
  <view class="hero-card">
    <view class="hero-top">
      <text class="detail-name">{{skirt.name}}</text>
      <text class="detail-brand" wx:if="{{skirt.brand}}">{{skirt.brand}}</text>
    </view>
    <view class="status-row">
      <text class="status-tag {{skirt.statusClass}}">{{skirt.statusText}}</text>
      <text class="type-badge" wx:if="{{skirt.type}}">{{skirt.type}}</text>
    </view>
    <view class="price-row">
      <text class="price-big">¥{{skirt.totalPrice}}</text>
      <text class="price-sub" wx:if="{{skirt.isPresale}}">全款预售</text>
      <text class="price-sub" wx:else>定 ¥{{skirt.deposit}} + 尾 ¥{{skirt.finalPayment}}</text>
    </view>
  </view>

  <!-- 信息列表 -->
  <view class="info-card">
    <view class="info-row" wx:if="{{skirt.category}}">
      <text class="info-label">类别</text>
      <text class="info-value">{{skirt.category}}</text>
    </view>
    <view class="info-row" wx:if="{{skirt.size}}">
      <text class="info-label">尺码</text>
      <text class="info-value">{{skirt.size}}</text>
    </view>
    <view class="info-row" wx:if="{{skirt.color}}">
      <text class="info-label">颜色</text>
      <view class="info-color">
        <view class="color-dot" style="background: {{skirt.color}};"></view>
      </view>
    </view>
    <view class="info-row" wx:if="{{skirt.type}}">
      <text class="info-label">类型</text>
      <text class="info-value">{{skirt.type}}</text>
    </view>
    <view class="info-row accessories-row" wx:if="{{skirt.accessoriesArray && skirt.accessoriesArray.length > 0}}">
      <text class="info-label">小物</text>
      <view class="accessories-tags">
        <text class="accessory-item" wx:for="{{skirt.accessoriesArray}}" wx:key="*this">{{item}}</text>
      </view>
    </view>
    <view class="info-row" wx:if="{{skirt.saleStart}}">
      <text class="info-label">开售时间</text>
      <text class="info-value">{{skirt.saleStart}}</text>
    </view>
    <view class="info-row" wx:if="{{skirt.finalStart}}">
      <text class="info-label">尾款时间</text>
      <text class="info-value">{{skirt.finalStart}}</text>
    </view>
    <view class="info-row" wx:if="{{skirt.note}}">
      <text class="info-label">备注</text>
      <text class="info-value note-value">{{skirt.note}}</text>
    </view>
    <view class="info-row" wx:if="{{skirt.purchaseLink}}">
      <text class="info-label">链接</text>
      <text class="info-value link-value" bindtap="copyLink">复制购买链接</text>
    </view>
  </view>

  <!-- 全款预售模式：标记已买/未买 -->
  <view class="action-card" wx:if="{{skirt.isPresale}}">
    <view class="action-title">购买状态</view>
    <view class="action-btns">
      <view class="action-btn bought-btn" bindtap="markAsBought">
        <text class="action-btn-icon">✅</text>
        <text class="action-btn-text">标记为已买</text>
      </view>
      <view class="action-btn unbought-btn" bindtap="markAsNotBought">
        <text class="action-btn-icon">❌</text>
        <text class="action-btn-text">标记为未买</text>
      </view>
    </view>
  </view>

  <!-- 底部操作 -->
  <view class="bottom-actions">
    <view class="bottom-btn edit-btn" bindtap="goToEdit">
      <text class="bottom-btn-text">编辑</text>
    </view>
    <view class="bottom-btn sold-btn {{skirt.isSold ? 'active' : ''}}" bindtap="toggleSold">
      <text class="bottom-btn-text">{{skirt.isSold ? '取消出掉' : '标记已出掉'}}</text>
    </view>
    <view class="bottom-btn photo-btn" bindtap="openImageManage">
      <text class="bottom-btn-text">管理图片</text>
    </view>
    <view class="bottom-btn delete-btn" bindtap="deleteSkirt">
      <text class="bottom-btn-text">删除</text>
    </view>
  </view>
</view>
</block>

<view wx:else class="loading">
  <text class="loading-text">加载中...</text>
</view>

<!-- 图片管理抽屉 -->
<view class="drawer-mask {{showImageManage ? 'show' : ''}}" catchtap="closeImageManage"></view>
<view class="drawer {{showImageManage ? 'show' : ''}}">
  <view class="drawer-handle"></view>
  <view class="drawer-title">✿ 管理图片</view>
  <view class="drawer-body">
    <view class="img-grid" wx:if="{{images.length > 0}}">
      <view class="img-cell" wx:for="{{images}}" wx:key="id">
        <image class="img-cell-img" src="{{item.displayUrl}}" mode="aspectFill"></image>
        <view class="img-cover-badge" wx:if="{{item.isCover}}">封面</view>
        <view class="img-cell-actions">
          <view class="img-cell-btn cover" wx:if="{{!item.isCover}}" catchtap="setCover" data-id="{{item.id}}">设封面</view>
          <view class="img-cell-btn del" catchtap="deleteImage" data-id="{{item.id}}">删除</view>
        </view>
      </view>
    </view>
    <view wx:else class="cabinet-empty-hint">还没有多图，点击下方按钮添加～</view>
    <view class="img-add-btn ripple" bindtap="onPickImage">
      <text class="img-add-btn-text">{{uploading ? '上传中...' : '+ 添加图片'}}</text>
    </view>
  </view>
  <view class="drawer-actions">
    <view class="drawer-btn primary ripple" bindtap="closeImageManage">完成</view>
  </view>
</view>
