page {
  background: #FFF7F9;
  padding: 24rpx;
  padding-bottom: 160rpx;
  overflow-x: hidden;
}

/* ===== 加载中 ===== */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #BBB;
}

/* ===== 图片轮播 ===== */
.hero-photo {
  width: 100%;
  height: 560rpx;
  border-radius: 32rpx;
  overflow: hidden;
  margin-bottom: 22rpx;
  background: linear-gradient(135deg, #FFEDF2, #FFE0EA);
  box-shadow: 0 8rpx 26rpx rgba(255, 155, 181, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-swiper {
  width: 100%;
  height: 100%;
}

.hero-swiper-img {
  width: 100%;
  height: 100%;
}

.hero-photo-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-hanger {
  position: relative;
  width: 64rpx;
  height: 40rpx;
  border: 5rpx solid #FFB6C1;
  border-top: none;
  border-radius: 0 0 32rpx 32rpx;
}

.placeholder-hanger::before {
  content: '';
  position: absolute;
  top: -30rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 5rpx;
  height: 30rpx;
  background: #FFB6C1;
}

.placeholder-hanger::after {
  content: '';
  position: absolute;
  top: -36rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 16rpx;
  height: 14rpx;
  border: 5rpx solid #FFB6C1;
  border-bottom: none;
  border-radius: 16rpx 16rpx 0 0;
}

/* ===== 英雄卡 ===== */
.hero-card {
  background: linear-gradient(135deg, #FFB6C1 0%, #FF9BB5 50%, #FF9BB5 100%);
  border-radius: 32rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 155, 181, 0.25);
  color: #FFFFFF;
  overflow: hidden;
}

.hero-top {
  margin-bottom: 18rpx;
}

.detail-name {
  font-size: 38rpx;
  font-weight: bold;
  color: #FFFFFF;
  display: block;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.detail-brand {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 6rpx;
}

.status-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.status-row .status-tag {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 22rpx;
  border-radius: 32rpx;
}

.status-row .status-tag.today {
  background: #FFFFFF;
  color: #E05A86;
  animation: breathe 1.8s ease-in-out infinite;
}

.status-row .status-tag.pending {
  background: rgba(255, 255, 255, 0.3);
  color: #FFFFFF;
  animation: breathe 1.8s ease-in-out infinite;
}

.status-row .status-tag.sold {
  background: #FFFFFF;
  color: #999;
}

.status-row .status-tag.paid {
  background: rgba(255, 255, 255, 0.25);
  color: rgba(255, 255, 255, 0.9);
}

@keyframes breathe {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.6; transform: scale(0.96); }
}

.type-badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.25);
  color: #FFFFFF;
}

.price-row {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.price-big {
  font-size: 48rpx;
  font-weight: bold;
  color: #FFFFFF;
}

.price-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* ===== 信息卡片 ===== */
.info-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 182, 193, 0.08);
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #F8F0F4;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #999;
  flex-shrink: 0;
}

.info-value {
  font-size: 26rpx;
  color: #4A2A2A;
  text-align: right;
  flex: 1;
  margin-left: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

.note-value {
  line-height: 1.5;
  word-break: break-all;
}

.link-value {
  color: #E05A86;
  text-decoration: underline;
}

.info-color {
  display: flex;
  align-items: center;
  margin-left: 24rpx;
}

.color-dot {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 3rpx solid #F0E0E4;
}

/* ===== 小物标签 ===== */
.accessories-row {
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
}

.accessories-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-left: 0;
  width: 100%;
}

.accessory-item {
  font-size: 22rpx;
  color: #E05A86;
  background: #FFF0F3;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  border: 1rpx solid #FFD0DC;
}

/* ===== 操作卡片（全款预售已买/未买） ===== */
.action-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 182, 193, 0.08);
}

.action-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #4A2A2A;
  margin-bottom: 18rpx;
}

.action-btns {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 20rpx 0;
  border-radius: 24rpx;
  transition: all 0.2s;
}

.action-btn:active {
  transform: scale(0.96);
}

.bought-btn {
  background: #FFF0F3;
  border: 2rpx solid #FFD0DC;
}

.unbought-btn {
  background: #F5F5F5;
  border: 2rpx solid #E8E8E8;
}

.action-btn-icon {
  font-size: 32rpx;
}

.action-btn-text {
  font-size: 26rpx;
  font-weight: 500;
}

.bought-btn .action-btn-text {
  color: #E05A86;
}

.unbought-btn .action-btn-text {
  color: #999;
}

/* ===== 底部操作 ===== */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(255, 182, 193, 0.12);
  z-index: 100;
}

.bottom-btn {
  flex: 1;
  padding: 22rpx 6rpx;
  text-align: center;
  border-radius: 32rpx;
}

.bottom-btn:active {
  transform: scale(0.97);
  transition: transform 0.1s;
}

.edit-btn {
  background: linear-gradient(135deg, #FFB6C1, #FF9BB5);
  box-shadow: 0 6rpx 18rpx rgba(255, 155, 181, 0.25);
}

.sold-btn {
  background: #FFF0F3;
  border: 2rpx solid #FFD0DC;
}

.sold-btn.active {
  background: #F5F0F2;
  border: 2rpx solid #E6E6E6;
}

.photo-btn {
  background: #FFFBFC;
  border: 2rpx solid #FFE0EA;
}

.delete-btn {
  background: #F5F0F2;
}

.bottom-btn-text {
  font-size: 25rpx;
  font-weight: 600;
}

.edit-btn .bottom-btn-text {
  color: #FFFFFF;
}

.sold-btn .bottom-btn-text {
  color: #E05A86;
}

.sold-btn.active .bottom-btn-text {
  color: #B39AA7;
}

.photo-btn .bottom-btn-text {
  color: #E05A86;
}

.delete-btn .bottom-btn-text {
  color: #999;
}

/* ===== 图片管理抽屉内容 ===== */
.img-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.img-cell {
  position: relative;
  border-radius: 20rpx;
  overflow: hidden;
  background: #FFF0F3;
}

.img-cell-img {
  width: 100%;
  height: 240rpx;
  display: block;
}

.img-cover-badge {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  font-size: 20rpx;
  color: #FFFFFF;
  background: var(--grad-rose);
  padding: 4rpx 16rpx;
  border-radius: 18rpx;
  box-shadow: var(--shadow-btn);
}

.img-cell-actions {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 10rpx;
  padding: 10rpx;
  background: linear-gradient(180deg, rgba(0,0,0,0), rgba(0,0,0,0.35));
}

.img-cell-btn {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  padding: 10rpx 0;
  border-radius: 18rpx;
}

.img-cell-btn.cover {
  color: #E05A86;
  background: rgba(255, 255, 255, 0.92);
}

.img-cell-btn.del {
  color: #FFFFFF;
  background: rgba(224, 90, 134, 0.85);
}

.img-add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 22rpx 0;
  background: var(--grad-rose);
  border-radius: 32rpx;
  box-shadow: var(--shadow-btn);
}

.img-add-btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.cabinet-empty-hint {
  text-align: center;
  font-size: 26rpx;
  color: #B39AA7;
  padding: 32rpx 0 24rpx;
}

/* ===== DressNest 主题层 ===== */
.page, .form, .detail-page, .loading {
  position: relative;
  z-index: 2;
}

.glass {
  background: rgba(255, 255, 255, 0.92) !important;
  backdrop-filter: blur(16rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.95) !important;
  box-shadow: 0 8rpx 26rpx rgba(255, 155, 181, 0.14) !important;
  border-radius: 32rpx;
}
.hero-card, .info-card, .action-card {
  background: rgba(255, 255, 255, 0.92) !important;
  backdrop-filter: blur(16rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 8rpx 26rpx rgba(255, 155, 181, 0.14);
  border-radius: 32rpx;
}
