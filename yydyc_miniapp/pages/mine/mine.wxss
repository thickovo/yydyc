page {
  background: #FFF7F9;
  min-height: 100vh;
}

.page {
  position: relative;
  z-index: 2;
  padding: 32rpx 28rpx 200rpx;
}

/* ============ 用户卡片 ============ */
.user-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 2rpx solid rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-radius: 40rpx;
  padding: 40rpx 34rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 10rpx 32rpx rgba(255, 155, 181, 0.16);
  transition: transform 0.15s ease;
}

.user-card:active {
  transform: scale(0.98);
}

.avatar {
  width: 124rpx;
  height: 124rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFDCE7 0%, #F3E8FA 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 6rpx 16rpx rgba(255, 155, 181, 0.2);
  overflow: hidden;
  border: 5rpx solid #FFFFFF;
}

.avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

.avatar-emoji {
  font-size: 60rpx;
  line-height: 1;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  min-width: 0;
}

.nickname {
  font-size: 36rpx;
  font-weight: 800;
  color: #5B3A48;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-id {
  font-size: 23rpx;
  color: #C9B4BD;
}

.user-card-arrow {
  color: #FFB6C1;
  font-size: 46rpx;
  font-weight: 200;
  line-height: 1;
}

/* ============ 设置卡片 ============ */
.settings-card {
  background: rgba(255, 255, 255, 0.88);
  border: 2rpx solid rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-radius: 32rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 8rpx 26rpx rgba(255, 155, 181, 0.12);
  overflow: hidden;
}

.setting-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 32rpx;
  border-bottom: 2rpx solid #FFF0F4;
}

.setting-row:last-child {
  border-bottom: none;
}

.setting-row:active {
  background: #FFF3F6;
}

.setting-left {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

/* ===== 图标：圆形渐变樱花底 + 中央图形 ===== */
.setting-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  flex-shrink: 0;
  background: var(--grad-pink);
  box-shadow: 0 4rpx 12rpx rgba(255, 155, 181, 0.32);
}

/* 消息提醒：可爱铃铛 */
.icon-bell::before {
  content: '';
  position: absolute;
  top: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 10rpx;
  height: 8rpx;
  border: 3rpx solid #FFFFFF;
  border-bottom: none;
  border-radius: 10rpx 10rpx 0 0;
}

.icon-bell::after {
  content: '';
  position: absolute;
  top: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 22rpx;
  height: 20rpx;
  background: linear-gradient(180deg, #FFFFFF, #FFE4EC);
  border-radius: 16rpx 16rpx 5rpx 5rpx;
}

.bell-clapper {
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #FFFFFF;
  z-index: 2;
}

/* 导出数据：向上小纸飞机/箭头 */
.icon-export::after {
  content: '';
  width: 0;
  height: 0;
  border-left: 9rpx solid transparent;
  border-right: 9rpx solid transparent;
  border-bottom: 14rpx solid #FFFFFF;
  margin-bottom: 6rpx;
}

.icon-export::before {
  content: '';
  position: absolute;
  bottom: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 4rpx;
  height: 12rpx;
  background: #FFFFFF;
  border-radius: 2rpx;
}

/* 导入数据：向下小箭头 */
.icon-import::after {
  content: '';
  width: 0;
  height: 0;
  border-left: 9rpx solid transparent;
  border-right: 9rpx solid transparent;
  border-top: 14rpx solid #FFFFFF;
  margin-top: 6rpx;
}

.icon-import::before {
  content: '';
  position: absolute;
  top: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 4rpx;
  height: 12rpx;
  background: #FFFFFF;
  border-radius: 2rpx;
}

/* 意见反馈：带圆点封蜡的小信封 */
.icon-feedback::after {
  content: '';
  width: 26rpx;
  height: 18rpx;
  border: 3rpx solid #FFFFFF;
  border-radius: 4rpx;
  background: transparent;
}

.icon-feedback::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #FFFFFF;
}

/* 关于：带蝴蝶结的信息牌 */
.icon-about::after {
  content: 'i';
  font-family: 'Georgia', serif;
  font-style: italic;
  font-weight: bold;
  font-size: 32rpx;
  color: #FFFFFF;
  line-height: 1;
  margin-top: 2rpx;
}

/* 联系作者：带信件的小信封 */
.icon-contact::after {
  content: '';
  width: 24rpx;
  height: 16rpx;
  border: 3rpx solid #FFFFFF;
  border-radius: 3rpx;
  margin-top: 4rpx;
}

.icon-contact::before {
  content: '';
  position: absolute;
  top: 14rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 16rpx;
  height: 10rpx;
  border: 3rpx solid #FFFFFF;
  border-bottom: none;
  border-radius: 2rpx 2rpx 0 0;
  background: rgba(255, 255, 255, 0.35);
}

/* ============ 设置项文本 ============ */
.setting-label {
  font-size: 30rpx;
  color: #5B3A48;
  font-weight: 500;
}

.setting-arrow {
  font-size: 36rpx;
  color: #FFD3DF;
  font-weight: 200;
}

/* ============ 底部装饰 ============ */
.mine-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 40rpx 0 0;
  opacity: 0.65;
}

.mine-footer-heart {
  font-size: 20rpx;
  color: #FFAFCA;
}

.mine-footer-text {
  font-size: 22rpx;
  color: #D8A9BC;
  letter-spacing: 3rpx;
}

/* ============ 抽屉内容 ============ */
.about-content {
  font-size: 27rpx;
  color: #7A5B6A;
  line-height: 1.9;
  white-space: pre-line;
  padding: 8rpx 12rpx;
}

.about-center {
  text-align: center;
  margin-bottom: 20rpx;
}

.contact-card {
  width: 100%;
  background: #FFF3F6;
  border: 2rpx solid #FFDCE7;
  border-radius: 28rpx;
  padding: 8rpx 0;
  margin: 8rpx 0 4rpx;
}

.contact-row {
  display: flex;
  align-items: center;
  padding: 26rpx 30rpx;
  gap: 16rpx;
}

.contact-row:active {
  background: #FFEBF1;
}

.contact-label {
  width: 100rpx;
  font-size: 26rpx;
  color: #A98E9C;
  flex-shrink: 0;
}

.contact-value {
  flex: 1;
  font-size: 28rpx;
  color: #E05A86;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.contact-action {
  font-size: 24rpx;
  color: #FFFFFF;
  background: var(--grad-rose);
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
}

.contact-divider {
  height: 2rpx;
  background: #FFDCE7;
  margin: 0 30rpx;
}

.modal-watermark {
  text-align: center;
  font-size: 22rpx;
  color: #C9B4BD;
  padding: 20rpx 0 4rpx;
}
