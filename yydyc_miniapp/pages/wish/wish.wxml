<!-- 背景图 -->
<image class="page-bg" src="/images/bg/list-bg.jpg" mode="aspectFill"></image>
<view class="page-bg-overlay"></view>

<view class="page">
  <!-- 页头 -->
  <view class="page-head">
    <view class="page-title-row">
      <view class="title-deco"></view>
      <text class="page-title">心愿单</text>
      <view class="title-deco"></view>
    </view>
    <text class="page-sub">想入手的裙子，都收在这个小抽屉里 ♪</text>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrap">
      <view class="search-icon"></view>
      <input class="search-input" placeholder="搜索心愿商品名称或品牌" value="{{keyword}}" bindinput="onKeywordInput" />
    </view>
  </view>

  <!-- 骨架屏 -->
  <view wx:if="{{loading}}">
    <view class="card" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="skeleton" style="width: 150rpx; height: 180rpx; border-radius: 24rpx;"></view>
      <view class="card-content">
        <view class="skeleton skeleton-line" style="width: 60%; height: 32rpx;"></view>
        <view class="skeleton skeleton-line" style="width: 40%; height: 24rpx; margin-top: 12rpx;"></view>
        <view class="skeleton skeleton-line" style="width: 80%; height: 24rpx; margin-top: 12rpx;"></view>
      </view>
    </view>
  </view>

  <!-- 列表 -->
  <view wx:elif="{{filteredWishList.length > 0}}">
    <view class="card {{item.isDone ? 'card-done' : ''}}" wx:for="{{filteredWishList}}" wx:key="id">
      <!-- 弹性勾选 -->
      <view class="wish-check {{item.isDone ? 'checked' : ''}}" data-id="{{item.id}}" bindtap="onToggleDone">
        <view class="wish-check-knob">
          <view wx:if="{{item.isDone}}" class="check-tick"></view>
        </view>
      </view>
      <view class="card-image" bindtap="onTapItem" data-id="{{item.id}}">
        <image wx:if="{{item.displayImageUrl}}" src="{{item.displayImageUrl}}" mode="aspectFill"></image>
        <view wx:else class="image-placeholder">
          <view class="placeholder-heart"></view>
        </view>
      </view>
      <view class="card-content" bindtap="onTapItem" data-id="{{item.id}}">
        <view class="name-row">
          <text class="name">{{item.name}}</text>
          <text class="brand" wx:if="{{item.brand}}">{{item.brand}}</text>
        </view>
        <view class="price-row">
          <text class="price" wx:if="{{item.price != null}}">¥{{item.price}}</text>
          <text class="link ripple" wx:if="{{item.purchaseLink}}" catchtap="onCopyLink" data-link="{{item.purchaseLink}}">
            <view class="link-dot"></view>链接
          </text>
        </view>
        <view class="meta-row" wx:if="{{item.doneTimeText}}">
          <text class="meta-text">{{item.isDone ? '✓ 已收入 · ' : ''}}{{item.doneTimeText}}</text>
        </view>
        <view class="note" wx:if="{{item.note}}">{{item.note}}</view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:else class="sakura-empty-block">
    <view class="sakura-empty-illust">
      <view class="sub-sakura sub-1">
        <view class="sakura size-sm">
          <view class="sakura-petal" style="transform: translate(-50%, -100%) rotate(0deg) translateY(-15rpx);"></view>
          <view class="sakura-petal" style="transform: translate(-50%, -100%) rotate(72deg) translateY(-15rpx);"></view>
          <view class="sakura-petal" style="transform: translate(-50%, -100%) rotate(144deg) translateY(-15rpx);"></view>
          <view class="sakura-petal" style="transform: translate(-50%, -100%) rotate(216deg) translateY(-15rpx);"></view>
          <view class="sakura-petal" style="transform: translate(-50%, -100%) rotate(288deg) translateY(-15rpx);"></view>
          <view class="sakura-center"></view>
        </view>
      </view>
      <view class="main-sakura">
        <view class="sakura size-md">
          <view class="sakura-petal" style="transform: translate(-50%, -100%) rotate(0deg) translateY(-30rpx);"></view>
          <view class="sakura-petal" style="transform: translate(-50%, -100%) rotate(72deg) translateY(-30rpx);"></view>
          <view class="sakura-petal" style="transform: translate(-50%, -100%) rotate(144deg) translateY(-30rpx);"></view>
          <view class="sakura-petal" style="transform: translate(-50%, -100%) rotate(216deg) translateY(-30rpx);"></view>
          <view class="sakura-petal" style="transform: translate(-50%, -100%) rotate(288deg) translateY(-30rpx);"></view>
          <view class="sakura-center"></view>
        </view>
      </view>
      <view class="sub-sakura sub-2">
        <view class="sakura size-sm">
          <view class="sakura-petal" style="transform: translate(-50%, -100%) rotate(0deg) translateY(-15rpx);"></view>
          <view class="sakura-petal" style="transform: translate(-50%, -100%) rotate(72deg) translateY(-15rpx);"></view>
          <view class="sakura-petal" style="transform: translate(-50%, -100%) rotate(144deg) translateY(-15rpx);"></view>
          <view class="sakura-petal" style="transform: translate(-50%, -100%) rotate(216deg) translateY(-15rpx);"></view>
          <view class="sakura-petal" style="transform: translate(-50%, -100%) rotate(288deg) translateY(-15rpx);"></view>
          <view class="sakura-center"></view>
        </view>
      </view>
    </view>
    <view class="sakura-empty-text">{{keyword ? '没有找到匹配的心愿' : '还没有心愿哦 ✨' + '\n' + '去记录想入手的裙子吧'}}</view>
  </view>

  <!-- 添加悬浮按钮（水波） -->
  <view class="add-fab ripple" bindtap="onAdd">
    <view class="add-fab-plus"></view>
  </view>
</view>
