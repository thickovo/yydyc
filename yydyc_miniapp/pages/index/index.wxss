page {
  margin: 0;
  padding: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.page {
  position: relative;
  width: 100%;
  height: 100%;
}

.bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* ===== 顶部区域 ===== */
.top-section {
  position: absolute;
  top: 60px;
  left: 0;
  width: 100%;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand {
  font-size: 18px;
  color: #FFFFFF;
  font-family: 'youyou', sans-serif;
  text-shadow: 0 2px 12px rgba(0, 0, 0, 0.8);
  margin-bottom: 8px;
  letter-spacing: 4px;
}

.days {
  font-size: 24px;
  color: #FFFFFF;
  font-weight: bold;
  font-family: 'youyou', sans-serif;
  text-shadow: 0 2px 12px rgba(0, 0, 0, 0.8);
  -webkit-text-stroke: 1px rgba(0, 0, 0, 0.15);
}

/* ===== 底部区域 ===== */
.bottom-section {
  position: absolute;
  bottom: 80px;
  left: 0;
  width: 100%;
  z-index: 10;
  display: flex;
  justify-content: center;
}

.quote {
  font-size: 20px;
  color: #FFFFFF;
  font-family: 'youyou', sans-serif;
  text-shadow: 0 2px 12px rgba(0, 0, 0, 0.8);
  -webkit-text-stroke: 1px rgba(0, 0, 0, 0.15);
}