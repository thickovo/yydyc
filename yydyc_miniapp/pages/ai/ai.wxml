<scroll-view class="chat-list" scroll-y scroll-top="{{scrollTop}}" scroll-with-animation>
  <view class="chat-inner">
    <view wx:if="{{messages.length === 0}}" class="welcome">
      <view class="welcome-icon">💬</view>
      <view class="welcome-text">你好呀，我是云裳记的 AI 助手{{'\n'}}想聊点什么都可以告诉我～</view>
    </view>

    <block wx:for="{{messages}}" wx:key="time">
      <view class="msg msg-{{item.role}}">
        <view wx:if="{{item.role === 'ai'}}" class="avatar avatar-ai">🤖</view>
        <view class="msg-bubble">{{item.content}}</view>
        <view wx:if="{{item.role === 'user'}}" class="avatar avatar-user">🧸</view>
      </view>
    </block>

    <view wx:if="{{sending}}" class="msg msg-ai">
      <view class="avatar avatar-ai">🤖</view>
      <view class="msg-bubble msg-loading">
        <view class="dot"></view><view class="dot"></view><view class="dot"></view>
      </view>
    </view>
  </view>
</scroll-view>

<view class="hint-bar">
  <text class="hint-text">🤖 AI 助手正在开发中，当前仅支持闲聊对话。如需数据查询功能，请耐心等待后续版本。</text>
</view>

<view class="input-bar">
  <input
    class="input"
    placeholder="说点什么吧..."
    value="{{inputText}}"
    bindinput="onInput"
    bindconfirm="onSend"
    confirm-type="send"
    hold-keyboard
  />
  <view class="send-btn {{sending ? 'disabled' : ''}}" bindtap="onSend">
    <view class="send-arrow"></view>
  </view>
</view>
