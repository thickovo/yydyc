page {
  background: #FFF7F9;
  min-height: 100vh;
  padding-bottom: 160rpx;
}

.page {
  /* padding-top 要避开状态栏 + 导航栏总高度（~88-100rpx），留点安全余量避免月份左右键与
     导航栏"记账日历"标题重叠 */
  padding: 56rpx 24rpx 0;
}

/* ============ 头部 ============ */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.month-switcher {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.month-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 300;
  color: #E05A86;
  box-shadow: 0 4rpx 12rpx rgba(255, 155, 181, 0.15);
}

.month-btn:active {
  transform: scale(0.92);
}

.month-label {
  font-size: 36rpx;
  font-weight: 800;
  color: #5B3A48;
  min-width: 200rpx;
  text-align: center;
  letter-spacing: 2rpx;
}

.today-btn {
  background: #FFF0F4;
  color: #E05A86;
  font-size: 24rpx;
  font-weight: 500;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  border: 2rpx solid #FFDCE7;
}

.today-btn:active {
  transform: scale(0.96);
  background: #FFE4EC;
}

/* ============ 日历卡片 ============ */
.calendar-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 24rpx 16rpx 16rpx;
  box-shadow: 0 6rpx 20rpx rgba(255, 182, 193, 0.12);
}

.weekday-row {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 0;
  padding: 12rpx 0 16rpx;
  border-bottom: 2rpx solid #FBF5F7;
}

.weekday {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  font-weight: 500;
}

.day-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 0;
}

.day-cell {
  position: relative;
  height: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 6rpx 4rpx;
  transition: all 0.15s;
}

.day-cell:active {
  background: #FFF5F7;
  border-radius: 16rpx;
}

.day-out .day-num {
  color: #DDD;
}

.day-today {
  background: linear-gradient(135deg, #FFEDF2, #FFD0DC);
  border-radius: 16rpx;
}

.day-today .day-num {
  color: #FFFFFF;
  font-weight: bold;
  background: linear-gradient(135deg, #FFB6C1, #FF9BB5);
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(255, 155, 181, 0.35);
}

.day-num {
  font-size: 28rpx;
  color: #4A2A2A;
  font-weight: 500;
}

.day-amount {
  font-size: 18rpx;
  color: #E05A86;
  font-weight: 600;
  line-height: 1;
}

.day-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
}

.day-has-data .day-num {
  color: #4A2A2A;
  font-weight: 600;
}

/* ============ 图例 ============ */
.legend {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  padding: 24rpx 0;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #999;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.legend-dot-data {
  background: #E05A86;
}

.legend-dot-today {
  background: linear-gradient(135deg, #FFB6C1, #FF9BB5);
}

/* ===== DressNest 主题层 ===== */
.page, .form, .detail-page, .loading {
  position: relative;
  z-index: 2;
}

.glass {
  background: rgba(255, 255, 255, 0.92) !important;
  backdrop-filter: blur(16rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.95) !important;
  box-shadow: 0 8rpx 26rpx rgba(255, 155, 181, 0.14) !important;
  border-radius: 32rpx;
}
.calendar-card {
  background: rgba(255, 255, 255, 0.92) !important;
  backdrop-filter: blur(16rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 8rpx 26rpx rgba(255, 155, 181, 0.14);
  border-radius: 32rpx;
}
